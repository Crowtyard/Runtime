{
  "manifest_version": "m3b-history-semantics-v1",
  "frozen_at": "M3B_CAUSAL_WORLD_HISTORY_SERVICE",
  "base": "M3A_SIMULATION_SEMANTICS_MANIFEST.json (0.3.0-m3a, unchanged)",
  "history_schema_version": "history-v1",
  "causal_link_id_schema_version": "causal-link-id-v1",
  "causal_history_hash_schema_version": "causal-history-hash-v1",
  "simulation_version": "0.3.0-m3a",
  "history_is_pure_index": true,
  "world_state_hash_unchanged": "v6 (history tables NOT in snapshot; M3a baselines byte-identical)",
  "event_stream_hash_unchanged": true,
  "node_kinds": ["EVENT", "STATE_CHANGE", "EPISODE", "PLAN", "DECISION",
                 "RECOVERY_STATE", "RESIDUAL", "SUCCESSION", "ENTITY",
                 "CHECKPOINT"],
  "relation_types": ["CAUSES", "TRIGGERS", "RESULTS_IN", "AFFECTS",
                     "CONTINUES", "RECOVERS_FROM", "CORRECTS", "SUPERSEDES",
                     "REVERSES", "DECIDED_BY", "PART_OF_EPISODE",
                     "DERIVED_FROM", "MATERIALIZES_IN"],
  "edge_direction": "source = explanation/cause, target = explained/result; trace follows incoming edges only",
  "tick_rules": {
    "FORWARD": ["CAUSES", "TRIGGERS", "RESULTS_IN", "AFFECTS", "CONTINUES",
                "RECOVERS_FROM", "DERIVED_FROM", "MATERIALIZES_IN"],
    "BACKWARD": ["PART_OF_EPISODE"],
    "NONE": ["DECIDED_BY"],
    "FREE": ["CORRECTS", "SUPERSEDES", "REVERSES"]
  },
  "relation_priority": {"CAUSES": 0, "TRIGGERS": 1, "RESULTS_IN": 2,
                        "AFFECTS": 3, "DECIDED_BY": 4, "CONTINUES": 5,
                        "RECOVERS_FROM": 6, "DERIVED_FROM": 7,
                        "PART_OF_EPISODE": 8, "MATERIALIZES_IN": 9,
                        "CORRECTS": 10, "SUPERSEDES": 11, "REVERSES": 12},
  "cycle_forbidden": "all relations except CORRECTS/SUPERSEDES/REVERSES (DAG-like)",
  "insertion_cycle_defense": "self-loop reject + reverse 2-cycle reject + EVENT CONTINUES chain DFS (depth 64); full graph guarantee by HISTORY_INTEGRITY_AUDIT",
  "supersede_policy": "each EVENT superseded at most once (loop prevention); old event outgoing ACTIVE links -> SUPERSEDED",
  "deterministic_ordering": "events: (blessed_tick, id); links: (committed_tick, relation priority, source_id, target_id, link_id)",
  "state_change_ledger": "history_state_changes (M3b-owned, inline provenance); NEVER inserts into M0 world_state_changes (keeps M3a tribulation_causal_links.state_change_ids byte-identical)",
  "read_only": true,
  "llm_calls": 0,
  "llm_tokens": 0,
  "network_calls": 0,
  "formal_world": {
    "causal_history_links": 0,
    "entity_history_index": 0,
    "history_state_changes": 0,
    "history_episode_index": 0,
    "history_index_state": 0
  },
  "metrics_schema_v2": {
    "OLD_METRIC_NAME": "entities_with_history",
    "NEW_METRIC_NAME": "entity_history_index_rows",
    "NEW_DISTINCT_METRIC": "distinct_entities_with_history",
    "REASON": "old value was raw entity_history_index row count (one row per (entity, link) pair), not distinct domain entities",
    "episode_mutually_exclusive_states": [
      "EPISODE_STATE_COMPLETED", "EPISODE_STATE_PRECURSOR",
      "EPISODE_STATE_PREPARATION", "EPISODE_STATE_IMPACT",
      "EPISODE_STATE_RESPONSE", "EPISODE_STATE_STABILIZATION",
      "EPISODE_STATE_RESIDUAL_CHANGE", "EPISODE_STATE_RECOVERY",
      "EPISODE_STATE_RESOURCE_SUCCESSION",
      "EPISODE_STATE_NEW_NORMAL_PENDING"
    ],
    "incomplete_predicate": "episode.status != 'COMPLETED'",
    "m3a_completed_predicate": "episode.current_stage == 'NEW_NORMAL' (includes NEW_NORMAL_PENDING)",
    "mutex_invariant": "sum(mutually exclusive states) == episodes_indexed"
  }
}
