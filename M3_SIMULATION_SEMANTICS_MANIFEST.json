  "rng_schema_version": "m1-derive-seed-v1",
  "rng_substreams": {
    "engines": "per (subsystem, blessed_period_tick)",
    "tribulation": ["TRIBULATION_SCHEDULE", "TRIBULATION_PROFILE",
                    "TRIBULATION_TARGET", "TRIBULATION_IMPACT",
                    "TRIBULATION_RECOVERY", "TRIBULATION_SUCCESSION"]
  },
  "identity_schemas": {
    "event_uid": "deterministic 128-bit (deterministic_event_uid)",
    "tribulation_episode_id": "tribulation-episode-id-v1",
    "impact_plan_id": "impact-plan-v2",
    "owner_decision_id": "owner-decision-v1",
    "domain_entity_id": "domain-entity-id-v1",
    "social_entity_id": "social-v2",
    "succession_candidate_id": "succession-candidate-v1"
  },
  "hash_schemas": {
    "world_state_hash": 6,
    "world_state_hash_v2_v3_v4_v5": "frozen regression baselines",
    "event_stream_hash_schema_version": 1,
    "causal_history_hash": "causal-history-hash-v1"
  },
  "hash_responsibilities": {
    "world_state_hash": "当前世界真值 (STATE)",
    "event_stream_hash": "发生路径 (EVENT PATH)",
    "causal_history_hash": "事实之间关系 (CAUSAL RELATION TRUTH)",
    "note": "三者职责互不替代；History 为派生/索引层，不得反向修改 Domain Truth"
  },
  "adaptive_time_resolution": "schedule/stage boundaries split SimulationInterval at integer blessed ticks; no float years",
  "cross_domain_atomicity": "PLAN_B: coordinator applies Domain-owned Impact Adapters in one WorldMutationContext",
  "crash_checkpoint_semantics": {
    "run_step": "no commit (fenced session owned by catch_up)",
    "crash_points": ["before_snapshot", "after_snapshot", "engine:<ID>",
                     "engine:TRIBULATION", "after_tribulation", "after_engines",
                     "before_apply", "during_apply", "before_checkpoint",
                     "after_checkpoint", "adapter:<DOMAIN>",
                     "tribulation:precursor", "tribulation:preparation",
                     "tribulation:impact_plan", "tribulation:recovery",
                     "tribulation:succession", "tribulation:new_normal"],
    "atomicity": "events + state changes + history links commit in ONE fenced transaction; crash rolls back all"
  },
  "fencing_semantics": {
    "lease": "WriterLease per writer; expires_at monotonic",
    "stale_writer": "FENCING_VIOLATION, zero authoritative mutation (State/Events/Episodes/History Links/Checkpoint)",
    "takeover": "new writer re-acquires lease, same interval retry idempotent"
  },
  "ack_ambiguity_semantics": {
    "post_durable_commit_ack_lost": "retry same interval -> ALREADY_COMMITTED",
    "no_duplicate": "population/resource/inventory/ecology/social effect, Episode, History Link, Checkpoint, Blessed Time",
    "gate": "PRE_ACTIVATION_PG_COMMIT_AMBIGUITY_GATE = REQUIRED"
  },
  "history_indexing_semantics": {
    "read_only_queries": true,
    "indexing_enabled_disabled": "affects only causal_history_hash + history index tables; world_state_hash / event_stream_hash unchanged",
    "ledger": "history_state_changes (M3b-owned; never writes M0 world_state_changes)",
    "relation_direction": "source = explanation, target = explained; trace follows incoming edges",
    "tick_rules": {
      "FORWARD": ["CAUSES", "TRIGGERS", "RESULTS_IN", "AFFECTS",
                  "CONTINUES", "RECOVERS_FROM", "DERIVED_FROM",
                  "MATERIALIZES_IN"],
      "BACKWARD": ["PART_OF_EPISODE"],
      "NONE": ["DECIDED_BY"],
      "FREE": ["CORRECTS", "SUPERSEDES", "REVERSES"]
    },
    "supersede_policy": "each EVENT superseded at most once; append-only corrections"
  },
  "metric_schema": "v2",
  "metrics": {
    "entity": ["entity_history_index_rows", "distinct_entities_with_history"],
    "deprecated": [{"OLD_METRIC_NAME": "entities_with_history",
                    "REASON": "raw index rows, not distinct entities"}],
    "episode_mutually_exclusive_states": [
      "EPISODE_STATE_COMPLETED", "EPISODE_STATE_PRECURSOR",
      "EPISODE_STATE_PREPARATION", "EPISODE_STATE_IMPACT",
      "EPISODE_STATE_RESPONSE", "EPISODE_STATE_STABILIZATION",
      "EPISODE_STATE_RESIDUAL_CHANGE", "EPISODE_STATE_RECOVERY",
      "EPISODE_STATE_RESOURCE_SUCCESSION",
      "EPISODE_STATE_NEW_NORMAL_PENDING"],
    "incomplete_predicate": "episode.status != 'COMPLETED'",
    "mutex_invariant": "sum(mutually exclusive states) == episodes_indexed"
  },
  "feedback_latency": "NEXT_COMMITTED_STEP",
  "tribulation_rank_inference": 0,
  "golden_baseline_policy": {
    "immutability": "normal pytest never writes tests/baselines/** (GB1 session snapshot + GB2 per-module bytes guard)",
    "compare": "candidate artifact built in memory -> deterministic deep compare vs committed golden (telemetry stripped); any deterministic diff FAILS (GB10)",
    "telemetry_excluded": ["performance", "wall_seconds", "wall_seconds_queries",
                           "query_latency_ms", "db_size_mb", "db_growth"],
    "effective_hash_schema_versions": {"M2b": 3, "M2c": 4, "M2d": 5,
                                       "M3a": 6},
    "explicit_update": "BLR_UPDATE_GOLDEN_BASELINES=1 via scripts/update_baselines.py only; manual git diff review + independent commit",
    "policy_doc": "tests/GOLDEN_BASELINES.md"
  },
  "formal_world": {
    "WORLD_RUNTIME_STATUS": "NOT_ACTIVATED",
    "seed": null,
    "current_blessed_tick": null,
    "tribulation_profiles": 0,
